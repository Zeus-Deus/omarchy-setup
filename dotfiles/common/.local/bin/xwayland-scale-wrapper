#!/usr/bin/env bash

set -euo pipefail

if (( $# == 0 )); then
  printf 'Usage: %s COMMAND [ARGUMENTS...]\n' "${0##*/}" >&2
  exit 2
fi

command -v hyprctl >/dev/null 2>&1 || {
  printf '%s\n' 'xwayland-scale-wrapper: hyprctl is required.' >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || {
  printf '%s\n' 'xwayland-scale-wrapper: jq is required.' >&2
  exit 1
}

command -v xrdb >/dev/null 2>&1 || {
  printf '%s\n' 'xwayland-scale-wrapper: xrdb is required.' >&2
  exit 1
}

scale="$({ hyprctl monitors -j || true; } | jq -er '
  (map(select(.focused == true))[0].scale) //
  (.[0].scale) //
  1
')"
readonly scale

dpi="$(awk -v scale="$scale" 'BEGIN { printf "%.2f", 96 * scale }')"
readonly dpi

printf 'Xft.dpi: %s\n' "$dpi" > "$HOME/.Xresources"
xrdb -merge "$HOME/.Xresources"

exec "$@"
