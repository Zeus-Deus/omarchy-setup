#!/usr/bin/env bash

set -euo pipefail

if [[ -z ${1:-} ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

if [[ ! $package =~ ^[a-zA-Z0-9@._+:/-]+$ || $package == -* ||
      $package == /* || $package == */ || $package == *//* ||
      $package == "." || $package == ".." ||
      $package == ./* || $package == */./* || $package == */. ||
      $package == ../* || $package == */../* || $package == */.. ]]; then
  echo "omarchy-mise-install: invalid package name" >&2
  exit 1
fi
if [[ $command == "." || $command == ".." || ! $command =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
  echo "omarchy-mise-install: invalid command name" >&2
  exit 1
fi
if [[ $bin == "." || $bin == ".." || ! $bin =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
  echo "omarchy-mise-install: invalid bin name" >&2
  exit 1
fi

mkdir -p "$HOME/.local/bin"
temporary=$(mktemp "$HOME/.local/bin/.${command}.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
cat >"$temporary" <<EOF
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
lock="\${XDG_STATE_HOME:-\$HOME/.local/state}/omarchy/mise-use.lock"
mkdir -p "\${lock%/*}"
flock "\$lock" mise use -g --quiet "$package" || exit 1
bin_path=
bin_paths=\$(mise bin-paths "$package") || exit 1
while IFS= read -r bin_dir; do
  [[ -n \$bin_dir ]] || continue
  if [[ -f "\$bin_dir/$bin" && -x "\$bin_dir/$bin" ]]; then
    bin_path="\$bin_dir/$bin"
    break
  fi
done <<<"\$bin_paths"
if [[ -z \$bin_path ]]; then
  echo "$command: mise package '$package' provides no executable '$bin'" >&2
  exit 1
fi
exec mise x "$package" -- "\$bin_path" "\$@"
EOF
chmod 755 "$temporary"
mv -f -- "$temporary" "$HOME/.local/bin/$command"
trap - EXIT
